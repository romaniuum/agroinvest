# Настройки боевого сервера. Скопируйте в /opt/agroinvest/.env и заполните.
# Этот файл с реальными значениями в Git не кладём.

# Домен без https:// и без www. DNS: записи A для домена и www → IP сервера
DOMAIN=
# Почта для Let's Encrypt (сюда придёт письмо, если сертификат не продлится)
ACME_EMAIL=

# База. Пароль — длинная случайная строка из латиницы и цифр, например: openssl rand -hex 24
POSTGRES_USER=agroinvest
POSTGRES_PASSWORD=
POSTGRES_DB=agroinvest

# Образ сайта. Чтобы откатиться, укажите тег коммита: ghcr.io/romaniuum/agroinvest:<sha>
APP_IMAGE=ghcr.io/romaniuum/agroinvest:latest

# Telegram: уведомления о заявках и о проблемах с бэкапом
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Почта для копий заявок
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=

# Яндекс SmartCaptcha (серверный ключ; ключ для браузера задаётся в GitHub при сборке)
SMARTCAPTCHA_SERVER_KEY=
