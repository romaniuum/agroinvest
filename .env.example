# Скопируйте этот файл в .env и заполните значения.
# Файл .env в Git не попадает.

# Адрес сайта без слэша в конце, нужен для ссылок в уведомлениях
SITE_URL=http://localhost:3000

# База данных (docker-compose.yml берёт POSTGRES_* отсюда)
POSTGRES_USER=agroinvest
POSTGRES_PASSWORD=
POSTGRES_DB=agroinvest
DATABASE_URL=postgresql://agroinvest:ПАРОЛЬ@localhost:5432/agroinvest?schema=public

# Telegram: токен бота от @BotFather и id группы менеджеров
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Почта: SMTP-сервер, с которого уходят письма, и адрес компании для копий заявок
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=

# Яндекс SmartCaptcha. Пока ключи пустые, проверка отключена
NEXT_PUBLIC_SMARTCAPTCHA_CLIENT_KEY=
SMARTCAPTCHA_SERVER_KEY=

# Папка для загруженных фото (на сервере — том Docker)
UPLOAD_DIR=uploads
